# Maintainer: playbook release bot <noreply at pragmatic-engineer dot dev>
#
# Rendered by scripts/render-pkgbuild.sh from packaging/aur/PKGBUILD.tmpl in
# https://github.com/pragmatic-engineer/playbook. Do not edit the AUR copy by
# hand except for a pkgrel or epoch fix; the release job keeps both.
@EPOCH_LINE@pkgname=playbook-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc='Playbook: skills, hooks and a CLI for Claude Code (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/pragmatic-engineer/playbook'
license=('Apache-2.0')
provides=('playbook')
conflicts=('playbook')
options=('!strip')
source_x86_64=("playbook-${pkgver}-x86_64-unknown-linux-musl::${url}/releases/download/v${pkgver}/playbook-${pkgver}-x86_64-unknown-linux-musl")
source_aarch64=("playbook-${pkgver}-aarch64-unknown-linux-musl::${url}/releases/download/v${pkgver}/playbook-${pkgver}-aarch64-unknown-linux-musl")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
  # The binary is a static musl build. One file is installed, plus pbtop as a
  # link to it: playbook started as pbtop runs the dashboard, so the two
  # always share a version. No pb link (playbook setup makes it), no hooks,
  # nothing under $HOME.
  install -Dm755 "${srcdir}/playbook-${pkgver}-${CARCH}-unknown-linux-musl" \
    "${pkgdir}/usr/bin/playbook"
  ln -s playbook "${pkgdir}/usr/bin/pbtop"
}
